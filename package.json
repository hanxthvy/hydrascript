{
  "name": "hydrascript",
  "version": "0.13.1",
  "description": "Pythonic Syntax for React & Modern Web Applications \u2014 Standalone native Rust compiler with zero runtime overhead",
  "type": "module",
  "bin": {
    "hydra": "bin/hydra.js"
  },
  "exports": {
    ".": "./packages/cli/runner.mjs",
    "./runner": "./packages/cli/runner.mjs",
    "./esbuild": "./packages/cli/esbuild-plugin.mjs",
    "./vite": "./packages/cli/esbuild-plugin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanxthvy/hydrascript.git"
  },
  "keywords": [
    "hydrascript",
    "react",
    "compiler",
    "meta-framework",
    "pythonic",
    "vite",
    "rust"
  ],
  "author": {
    "name": "Reyhan Akhtar Afriansyah (Hanz)",
    "url": "https://github.com/hanxthvy"
  },
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16"
  },
  "scripts": {
    "build:compiler": "cd compiler-rs && cargo build --release && cp target/release/hydra ../bin/hydra && cargo rustc --release --lib --features node-addon --crate-type cdylib && cp target/release/libhydra.so ../bin/hydra.node",
    "test": "cd compiler-rs && cargo test && cd .. && npm run test:node",
    "test:server": "node --test packages/cli/server.test.mjs",
    "test:rust": "cd compiler-rs && cargo test",
    "test:node": "node --test --test-concurrency=1 packages/cli/*.test.mjs",
    "test:examples": "bash scripts/hx-examples-check.sh",
    "bench:routes": "node benchmarks/routes.mjs && node benchmarks/route-table.mjs",
    "types": "hydra types",
    "prepublishOnly": "npm run test:node && bash scripts/pack-install-check.sh",
    "test:files": "bash scripts/test-per-file.sh",
    "bench:dev": "node benchmarks/dev-reload.mjs examples/blog 3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "packages/",
    "runtime/",
    "vite-plugin/index.js",
    "vite-plugin/package.json",
    "schema.json",
    "LICENSE",
    "README.md",
    "README.id.md",
    "docs/",
    "SPEC.md",
    "MIGRATING.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/hanxthvy/hydrascript#readme",
  "bugs": {
    "url": "https://github.com/hanxthvy/hydrascript/issues"
  },
  "optionalDependencies": {}
}
