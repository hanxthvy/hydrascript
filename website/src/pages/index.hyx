# [xihanzu-NR]
from hydra import Link
from "../components/Code.hyx" import Code, CopyCommand

meta = {
    "title": "HydraScript — a Pythonic syntax for React",
    "description": "Indentation instead of closing tags, compiled by a native Rust binary. File-based routing, per-route static rendering, and no hidden machinery.",
}

SOURCE = [
    "from hydra import state",
    "",
    "component Counter(start: int = 0):",
    "    count, set_count = state(start)",
    "",
    "    div(className=\"counter\"):",
    "        h2: f\"Value: {count}\"",
    "        button(onClick=lambda: set_count(count + 1)): \"Add\"",
]

OUTPUT = [
    "// GENERATED by hydra — edit the .hyx file, not this one",
    "import { state } from 'hydra';",
    "",
    "export function Counter({ start = 0 }: CounterProps) {",
    "  let [count, set_count] = state(start);",
    "  return (",
    "    <div className=\"counter\">",
    "      <h2>{`Value: ${count}`}</h2>",
    "      <button onClick={(() => set_count((count + 1)))}>Add</button>",
    "    </div>",
    "  );",
    "}",
]

FEATURES = [
    ("rust", "Compiled, not interpreted", "The transform from .hyx to React is a native Rust binary. No virtual machine, no interpreter, no framework runtime in the output — the only HydraScript-specific thing in the emitted file is the hydra import, and it appears only when a file uses a helper."),
    ("routes", "The folder is the route table", "src/pages/about.hyx is /about. [slug] and [...rest] for parameters, _layout.hyx to wrap a folder, _404 and _error at any level. hydra routes prints the table, so nothing about your URLs is secret."),
    ("ssg", "One HTML file per route", "A build pre-renders every static route into its own document and names the dynamic ones it skipped. No shell-only sites, no discovery at runtime."),
    ("explicit", "Explicit, by policy", "No auto-import, no conventions the compiler invented for you. If a name is used it was written down somewhere, and hydra check can prove it."),
    ("targets", "Two build targets", "static or node. There is no adapter zoo, because a third target is a cost without a reader until someone actually asks for one."),
    ("frozen", "The syntax is frozen", "No new language features before 1.0. A small language earns trust by standing still long enough for people to build on it."),
]

COMPARISON = [
    ("Element nesting", "Closing tags", "Indentation", "Read the emitted TSX"),
    ("Multi-branch UI", "Nested ternaries / IIFE", "if / elif / else, match", "Compiled both"),
    ("Dynamic classes", "clsx(...) import", "cls={...} dict, no import", "Emitted cx(...)"),
    ("Prevent + stop", "Manual e.preventDefault()", "on_submit_prevent_stop=fn", "Emitted both calls"),
    ("List rendering", ".map() + key", "for x in xs: + key=", "Emitted .map()"),
    ("Interpolation", "Template literals", "f-strings", "Emitted template literal"),
    ("State", "const [v, setV] = useState()", "v, set_v = state()", "Emitted useState"),
    ("Multiple roots", "Manual <>...</>", "Automatic", "Emitted fragment"),
]

NOT_DOING = [
    ("React Server Components", "A different architecture, not an addition. HydraScript emits ordinary client React, and says so instead of pretending otherwise."),
    ("Islands", "Astro's model is a different model, not a better one. Adopting it would mean rewriting the emitter, not extending it."),
    ("Auto-import", "It would collide with hydra check and with the one claim that is hardest to copy: everything is written down."),
]


component Home():
    div(className="hero"):
        div(className="hero-inner"):
            span(className="eyebrow"): "0.15.1 · pre-1.0 · syntax frozen at 0.3"
            h1():
                "React, without the angle brackets."
                span(className="sub"): "A Pythonic syntax for React, compiled by a native Rust binary."
            p(className="hero-lede"):
                "You write indentation. You get plain, readable React out the other side — no runtime, no "
                "virtual machine, no framework object in your bundle. The router, the static renderer, "
                "the dev server and the test runner are all the same small toolchain."
            div(className="hero-actions"):
                Link(to="/docs", className="btn btn-primary"): "Start reading"
                a(
                    href="https://github.com/hanxthvy/hydrascript",
                    target="_blank",
                    rel="noopener",
                    className="btn",
                ): "Source on GitHub"
                CopyCommand(text="npm i -D hydrascript", label="copy")

    section(className="section"):
        div(className="wrap"):
            div(className="section-head"):
                h2(): "Thirty seconds"
                p(): "A counter, both sides of the compiler. The right-hand column is verbatim output, with only the base64 source-map footer trimmed."

            div(className="split"):
                Code(file="Counter.hyx", lang="hydrascript", lines=SOURCE)
                Code(file="Counter.tsx", lang="tsx (generated)", lines=OUTPUT)

            div(className="badge-row"):
                span(className="badge"): "188 → 130 tokens"
                span(className="badge"): "1.9 ms compile"
                span(className="badge"): "0 bytes of framework runtime"

    section(className="section"):
        div(className="wrap"):
            div(className="section-head"):
                h2(): "What you are actually getting"
                p(): "Six claims, each one inspectable in the repository."
            div(className="grid grid-3"):
                for item in FEATURES:
                    div(className="card", key=item[0]):
                        span(className="tag"): item[0]
                        h3(): item[1]
                        p(): item[2]

    section(className="section"):
        div(className="wrap"):
            div(className="section-head"):
                h2(): "The honest comparison"
                p():
                    "HydraScript is shorter for the things JSX is verbose about, and neither better nor "
                    "worse for everything else. Every row below was verified by reading compiler output, "
                    "not by intent."
            div(className="table-wrap"):
                table():
                    thead():
                        tr():
                            th(): "Area"
                            th(): "TSX"
                            th(): "HydraScript"
                            th(): "Verified how"
                    tbody():
                        for row in COMPARISON:
                            tr(key=row[0]):
                                td(): row[0]
                                td(): row[1]
                                td(): row[2]
                                td(): row[3]

    section(className="section"):
        div(className="wrap"):
            div(className="section-head"):
                h2(): "What it refuses to do"
                p(): "These are decisions written in the README, not gaps discovered later."
            div(className="grid grid-3"):
                for item in NOT_DOING:
                    div(className="card", key=item[0]):
                        h3(): item[0]
                        p(): item[1]

    section(className="section"):
        div(className="wrap"):
            div(className="section-head"):
                h2(): "Read it, then check it"
                p():
                    "The language contract is in SPEC.md, the migration path for every breaking change is "
                    "in MIGRATING.md, and the numbers on this page are reproduced by cargo test and "
                    "node --test on every release."
            div(className="badge-row"):
                span(className="badge"): "428 Rust tests"
                span(className="badge"): "255 Node tests"
                span(className="badge"): "33 suites"
                span(className="badge"): "7 prebuilt platforms"
                span(className="badge"): "0 failures on the last run"
