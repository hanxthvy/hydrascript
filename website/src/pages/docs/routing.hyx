# [xihanzu-NR]
from hydra import Link
from "../../components/Code.hyx" import Code

meta = {
    "title": "Routing and rendering — HydraScript",
    "description": "File-based routes, nested layouts, per-route static rendering, metadata, loaders, API routes and middleware.",
}

ROUTES = [
    "src/pages/index.hyx            -> /",
    "src/pages/about.hyx            -> /about",
    "src/pages/blog/index.hyx       -> /blog",
    "src/pages/blog/[slug].hyx      -> /blog/:slug",
    "src/pages/docs/[...rest].hyx   -> /docs/*   (one segment or more)",
    "src/pages/files/[[...rest]].hyx -> /files/* (also /files itself)",
    "src/pages/(marketing)/price.hyx -> /price   (group: layout scope only)",
    "src/pages/_partials/Hero.hyx   -> not routable",
]

ROUTE_TABLE = [
    "$ hydra routes",
    "/              static   src/pages/index.hyx",
    "/docs          static   src/pages/docs/index.hyx        layout: src/pages/_layout.hyx, src/pages/docs/_layout.hyx",
    "/blog/:slug    dynamic  src/pages/blog/[slug].hyx",
    "/404           404      src/pages/_404.hyx",
]

SERVER = [
    "# src/pages/blog/[slug].server.hys — never shipped to the browser",
    "POSTS = [\"hello\", \"world\"]",
    "",
    "export def static_params():",
    "    return [{\"slug\": p} for p in POSTS]",
    "",
    "export def loader(event):",
    "    return {\"post\": find_post(event.params[\"slug\"])}",
    "",
    "export def metadata(event):",
    "    slug = event.params[\"slug\"]",
    "    return {",
    "        \"title\": \"Post \" + slug,",
    "        \"canonical\": \"https://example.com/blog/\" + slug,",
    "    }",
]

API = [
    "# src/api/hello.hys",
    "export def get(req):",
    "    return {\"ok\": True, \"at\": now_iso()}",
    "",
    "export def post(req, body):",
    "    return {\"created\": body[\"name\"]}, 201",
    "",
    "# src/middleware.hys — one file, /api and below",
    "export def handle(req):",
    "    if req.path.startswith(\"/api/admin\"):",
    "        return {\"error\": \"blocked by middleware\"}, 403",
    "    return None",
]

TARGETS = [
    ("static", "HTML per route, the client shell for dynamic ones. The api/ folder and middleware are reported as dropped, loudly."),
    ("node", "The same pages plus a real handler: API routes, middleware and per-request rendering."),
]


component Routing():
    h1(): "Routing and rendering"
    p(className="lede"):
        "The folder is the route table, the build tells you what it pre-rendered, and the two places "
        "that can hold secrets are separated by file type rather than by convention."

    h2(): "File conventions"
    Code(file="routes", lang="tree", lines=ROUTES)
    p():
        "A leading underscore is private: not routable, and not an error. A group in parentheses "
        "keeps its layout scope without appearing in the URL. Two files claiming one URL is a build "
        "error naming both, not a race decided silently."

    h2(): "Print the table"
    Code(file="commands", lang="output", lines=ROUTE_TABLE)
    p():
        "hydra routes --json carries each route's meta too, so the title a page declares is "
        "inspectable from the shell instead of only from the built HTML."

    h2(): "Layouts, 404 and error boundaries"
    p():
        "_layout.hyx wraps every route in its folder and below, _404.hyx renders when nothing "
        "matches, and _error.hyx is the React error boundary for its folder. All three may appear at "
        "several levels and the nearest one wins. A layout renders slot for its children, so nothing "
        "new is needed in the language."

    h2(): "Static rendering, per route"
    p():
        "A build writes one HTML file per static route: dist/about/index.html, not one shell for the "
        "whole site. Dynamic routes are skipped and named in the log. When a route can say which "
        "instances it has, it becomes real pages instead:"
    Code(file="[slug].server.hys", lang="hydrascript", lines=SERVER)
    p():
        "Returning [] from static_params means no static instances, render per request — honoured, "
        "because a dashboard should not be pre-rendered. metadata(event) exists because a static meta "
        "dict is one dict for the whole route: /blog/hello and /blog/world could otherwise only share "
        "a title."

    h2(): "API routes and middleware"
    Code(file="server half", lang="hydrascript", lines=API)
    p():
        "A handler must be exported. A file that defines one locally is a build error naming the file, "
        "rather than a build that stays green and answers 405 to every request. Middleware covers /api "
        "and below, and deliberately does not run for static files, because a static host has no "
        "middleware and dev would then disagree with production about /about."

    h2(): "Secrets are split by name"
    p():
        "Only PUBLIC_ variables are inlined into the client bundle. Using a secret in a client file is "
        "a build error that names the variable, not an undefined at runtime. The check runs on the "
        "compiled output of every module in the client graph, so a .hys imported by a component is "
        "covered too."

    h2(): "Two targets"
    div(className="table-wrap"):
        table():
            thead():
                tr():
                    th(): "hydra build --target"
                    th(): "What ships"
            tbody():
                for item in TARGETS:
                    tr(key=item[0]):
                        td():
                            code(): item[0]
                        td(): item[1]
    p():
        "A third value is rejected before anything is bundled. The default stays static, because that "
        "is what every earlier release produced."

    div(className="pager"):
        Link(to="/docs/syntax"): "← Syntax"
        Link(to="/docs/cli"): "CLI & config →"
