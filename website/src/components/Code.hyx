# [xihanzu-NR]
from hydra import state


def copy_now(text: str, setter):
    # The label first: the clipboard API is async and the browser may refuse it
    # entirely (no permission, insecure origin), and a button that does nothing
    # at all is worse than one that admits the copy failed.
    setter(True)
    clip = getattr(navigator, "clipboard", None)
    if clip:
        clip.writeText(text)


component Code(file: str = "", lang: str = "", lines = []):
    div(className="code-block"):
        div(className="code-head"):
            span(className="file"): file
            span(className="lang"): lang
        pre(className="code-body"):
            code(): "\n".join(lines)


component CopyCommand(text: str = "npm i -D hydrascript", label: str = "copy"):
    copied, set_copied = state(False)

    div(className="install"):
        span(className="prompt"): "$"
        code(): text
        button(className="copy-btn", onClick=lambda: copy_now(text, set_copied)):
            "copied" if copied else label
