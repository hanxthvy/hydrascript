# [xihanzu-NR]
# recharts — ResponsiveContainer + LineChart / BarChart composition

from "recharts" import ResponsiveContainer, LineChart, Line, BarChart, Bar
from "recharts" import XAxis, YAxis, CartesianGrid, Tooltip, Legend

from "hydra" import state, computed, cx

from "./Section.hyx" import Section

REVENUE = [
    {"month": "Jan", "mrr": 3200, "churn": 120},
    {"month": "Feb", "mrr": 4100, "churn": 90},
    {"month": "Mar", "mrr": 3800, "churn": 150},
    {"month": "Apr", "mrr": 5200, "churn": 60},
    {"month": "May", "mrr": 6100, "churn": 45},
    {"month": "Jun", "mrr": 7400, "churn": 70},
]

AXIS = {"stroke": "#64748b", "fontSize": 11}
GRID = {"stroke": "#1e293b", "strokeDasharray": "3 3"}
TOOLTIP_STYLE = {"contentStyle": {"background": "#0f172a", "border": "1px solid #1e293b", "borderRadius": "8px"}}


def total_mrr(rows: list):
    t = 0
    for r in rows:
        t = t + r["mrr"]
    return t


component LinePanel(rows=None):
    data = rows or []
    div(cls="h-64 w-full"):
        ResponsiveContainer(width="100%", height="100%"):
            LineChart(data=data, margin={"top": 5, "right": 8, "left": -18, "bottom": 0}):
                CartesianGrid(**GRID)
                XAxis(dataKey="month", tick=AXIS)
                YAxis(tick=AXIS)
                Tooltip(**TOOLTIP_STYLE)
                Legend()
                Line(type_="monotone", dataKey="mrr", stroke="#8b5cf6", strokeWidth=2, dot=False)
                Line(type_="monotone", dataKey="churn", stroke="#f43f5e", strokeWidth=2, dot=False)


component BarPanel(rows=None):
    data = rows or []
    div(cls="h-64 w-full"):
        ResponsiveContainer(width="100%", height="100%"):
            BarChart(data=data, margin={"top": 5, "right": 8, "left": -18, "bottom": 0}):
                CartesianGrid(**GRID)
                XAxis(dataKey="month", tick=AXIS)
                YAxis(tick=AXIS)
                Tooltip(**TOOLTIP_STYLE)
                Legend()
                Bar(dataKey="mrr", fill="#8b5cf6", radius=[4, 4, 0, 0])
                Bar(dataKey="churn", fill="#f43f5e", radius=[4, 4, 0, 0])


component ChartDemo():
    mode, set_mode = state("line")
    total = computed(lambda: total_mrr(REVENUE), [])
    peak = computed(lambda: max([r["mrr"] for r in REVENUE]), [])

    Section(title="Charts", lib="recharts", subtitle="ResponsiveContainer + Line/Bar composition"):
        div(cls="mb-3 flex flex-wrap items-center gap-2"):
            for m in ["line", "bar"]:
                button(
                    key=m,
                    cls=cx(
                        "rounded-lg px-3 py-1.5 text-xs font-medium",
                        {"bg-violet-600 text-white": mode == m},
                        {"bg-slate-800 text-slate-300 hover:bg-slate-700": mode != m},
                    ),
                    on_click=lambda m=m: set_mode(m),
                ):
                    m.capitalize()
            span(cls="ml-auto text-xs text-slate-500"):
                f"total MRR {total} · peak {peak}"

        if mode == "line":
            LinePanel(rows=REVENUE)
        else:
            BarPanel(rows=REVENUE)
