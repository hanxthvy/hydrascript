# [xihanzu-NR]
# react-router-dom — BrowserRouter, Routes, Route, Link, useNavigate, useParams
#
# NOTE (failure being documented): react-router-dom v7 exports its parts as
# dot-notation members of the package (e.g. `RouterProvider`, and the v6-style
# `<Routes>`/`<Route>` composition). HydraScript tags cannot express `<Select.Root>`
# so only *named* exports are usable. Everything below uses named exports.

from "react-router-dom" import BrowserRouter, Routes, Route, Link, useNavigate, useParams

from "hydra" import use_path

from "./Section.hyx" import Section


component ParamProbe():
    params = useParams()
    div(cls="rounded-lg bg-slate-950/60 px-3 py-2 text-xs"):
        span(cls="text-slate-500"): "useParams → "
        span(cls="font-mono text-violet-300"): f"id = {str(params.id)}"


component Inner():
    nav = useNavigate()
    path = use_path()

    div(cls="space-y-3"):
        p(cls="text-xs text-slate-500"):
            f"current location: {path}"
        div(cls="flex flex-wrap gap-2"):
            Link(
                to="/",
                cls="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-slate-200 hover:bg-slate-700",
            ):
                "Home"
            Link(
                to="/widget/42",
                cls="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-slate-200 hover:bg-slate-700",
            ):
                "Widget 42"
            button(
                cls="rounded-lg bg-violet-600 px-3 py-1.5 text-xs text-white hover:bg-violet-500",
                on_click=lambda: nav("/widget/99"),
            ):
                "navigate('/widget/99')"

        Routes():
            Route(path="/widget/:id", element=ParamProbe())


component RouterDemo():
    html = "<Routes><Route path=\"/widget/:id\" element={ParamProbe} /></Routes>"

    Section(title="Routing", lib="react-router-dom", subtitle="BrowserRouter + Routes/Route as component children"):
        code(cls="mb-3 block rounded-lg bg-slate-950 px-3 py-2 font-mono text-[11px] text-slate-400"):
            html
        BrowserRouter():
            Inner()
