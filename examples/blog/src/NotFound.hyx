# [xihanzu-NR]
# Fallback UI for a post id that is not numeric or out of range.

from "serpent" import navigate


component NotFound():
    div(cls="mx-auto max-w-xl rounded-xl border border-slate-800 bg-slate-900/60 p-12 text-center"):
        p(cls="text-5xl font-semibold text-slate-700"): "404"
        h2(cls="mt-4 text-lg font-semibold text-white"): "No such post"
        p(cls="mt-1 text-sm text-slate-400"):
            "That post id is not a number between 1 and 100."
        button(
            cls="mt-6 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-500",
            on_click=lambda: navigate("/"),
        ):
            "Back to the list"
