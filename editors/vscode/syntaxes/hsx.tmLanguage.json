{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HydraScript",
  "scopeName": "source.hsx",
  "fileTypes": ["hyx", "hys"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#component" },
    { "include": "#tree-block" },
    { "include": "#control-flow" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#slot" },
    { "include": "#functions" },
    { "include": "#properties" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hsx",
          "match": "#.*$"
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "comment": "The specifier is a STRING (`from \"hydra/server\" import session`); an unquoted one is a parse error, so it is coloured as the string it has to be.",
          "name": "meta.import.hsx",
          "begin": "^\\s*(from)\\s+(\"[^\"]*\")",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.hsx" },
            "2": { "name": "string.quoted.double.specifier.hsx" }
          },
          "end": "$",
          "patterns": [
            { "name": "keyword.control.import.hsx", "match": "\\b(import|as)\\b" },
            { "name": "variable.other.import.hsx", "match": "[A-Za-z_][A-Za-z0-9_]*" },
            { "name": "punctuation.separator.comma.hsx", "match": "," }
          ]
        },
        {
          "name": "meta.import.hsx",
          "match": "^\\s*(import)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.hsx" },
            "2": { "name": "string.quoted.double.specifier.hsx" }
          }
        }
      ]
    },

    "component": {
      "patterns": [
        {
          "name": "meta.component.hsx",
          "begin": "^\\s*(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.component.hsx" },
            "2": { "name": "entity.name.type.component.hsx" }
          },
          "end": "(?=^\\s*\\S|\\z)",
          "patterns": [
            { "include": "#params" },
            { "include": "#type-annotation" },
            { "include": "#body" }
          ]
        }
      ]
    },

    "params": {
      "patterns": [
        {
          "name": "meta.params.hsx",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.hsx" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parens.end.hsx" } },
          "patterns": [
            { "include": "#type-annotation" },
            { "include": "#strings" },
            { "include": "#constants" },
            { "name": "variable.parameter.hsx", "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?::|=|,|\\)))" },
            { "name": "keyword.operator.assignment.hsx", "match": "=" },
            { "name": "punctuation.separator.comma.hsx", "match": "," },
            { "name": "keyword.operator.type.hsx", "match": "->" }
          ]
        }
      ]
    },

    "type-annotation": {
      "patterns": [
        {
          "name": "meta.type.hsx",
          "match": "(?<=:)\\s*([A-Za-z_][A-Za-z0-9_.]*(?:\\[[^\\]]*\\])?(?:\\s*\\|\\s*[A-Za-z_][A-Za-z0-9_.]*)*)",
          "captures": {
            "1": { "name": "support.type.hsx" }
          }
        }
      ]
    },

    "tree-block": {
      "comment": "A tag followed by ':' opens a JSX block. This is the core of the language: the tag name is an element, the parenthesised part is its attributes.",
      "patterns": [
        {
          "name": "meta.tree.hsx",
          "begin": "^\\s*([a-z][a-zA-Z0-9]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.tag.hsx" },
            "2": { "name": "punctuation.section.parens.begin.hsx" }
          },
          "end": "\\)\\s*:",
          "endCaptures": { "0": { "name": "punctuation.section.block.begin.hsx" } },
          "patterns": [
            { "include": "#jsx-attributes" }
          ]
        },
        {
          "name": "meta.tree.hsx",
          "match": "^\\s*([a-z][a-zA-Z0-9]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.tag.hsx" },
            "2": { "name": "punctuation.section.block.begin.hsx" }
          }
        }
      ]
    },

    "jsx-attributes": {
      "patterns": [
        {
          "name": "meta.attribute.hsx",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.hsx" },
            "2": { "name": "keyword.operator.assignment.hsx" }
          }
        },
        { "include": "#strings" },
        { "include": "#fstrings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#operators" },
        { "name": "punctuation.separator.comma.hsx", "match": "," },
        { "name": "punctuation.section.brackets.hsx", "match": "[\\[\\]\\{\\}]" },
        { "name": "punctuation.section.parens.hsx", "match": "[()]" }
      ]
    },

    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.hsx",
          "match": "\\b(if|elif|else|for|in|while|return|break|continue|pass|match|case|try|except|finally|with|raise|yield)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        { "name": "storage.type.function.hsx", "match": "\\b(async|await|export|def)\\b" },
        { "name": "storage.type.class.hsx", "match": "\\bclass\\b" },
        { "name": "storage.type.component.hsx", "match": "\\bcomponent\\b" },
        { "name": "keyword.control.flow.hsx", "match": "\\b(lambda|as|from|import)\\b" },
        { "name": "keyword.operator.logical.hsx", "match": "\\b(and|or|not|is)\\b" }
      ]
    },

    "builtins": {
      "comment": "Only the names the COMPILER lowers or injects (compiler-rs/src/check.rs, PYTHON_BUILTINS). A name that is merely a Python builtin is a ReferenceError here, so colouring it as supported would be a lie.",
      "patterns": [
        {
          "name": "support.function.builtin.hsx",
          "match": "\\b(abs|bool|len|list|max|min|pow|print|reversed|round|sorted|str|sum|int|float|isinstance|enumerate|range|zip|type|ord|chr|divmod|any|all|map|filter|getattr|hasattr|setattr|repr)(?=\\s*\\()"
        },
        { "name": "variable.language.self.hsx", "match": "\\b(self|cls)\\b" }
      ]
    },

    "slot": {
      "comment": "`slot` is where a component's children render. A bare name, not a call and not a builtin.",
      "patterns": [
        { "name": "constant.language.slot.hsx", "match": "\\bslot\\b" }
      ]
    },

    "functions": {
      "patterns": [
        { "name": "entity.name.function.hsx", "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()" }
      ]
    },

    "properties": {
      "patterns": [
        { "name": "variable.other.property.hsx", "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.hsx", "match": "\\b(True|False|None)\\b" }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#fstrings" },
        {
          "name": "string.quoted.triple.hsx",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "name": "constant.character.escape.hsx", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.double.hsx",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.hsx", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.hsx",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.hsx", "match": "\\\\." }]
        }
      ]
    },

    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.hsx",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.hsx",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.hsx" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.hsx" } },
              "patterns": [
                { "include": "#keywords" },
                { "include": "#builtins" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#properties" },
                { "name": "variable.other.hsx", "match": "[A-Za-z_][A-Za-z0-9_]*" }
              ]
            },
            { "name": "constant.character.escape.hsx", "match": "\\\\." }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hsx",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.hsx", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.augmented.hsx", "match": "\\+=|-=|\\*=|//=|/=|%=" },
        { "name": "keyword.operator.arithmetic.hsx", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.hsx", "match": "=" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.parens.hsx", "match": "[()]" },
        { "name": "punctuation.section.brackets.hsx", "match": "[\\[\\]]" },
        { "name": "punctuation.section.braces.hsx", "match": "[\\{\\}]" },
        { "name": "punctuation.separator.comma.hsx", "match": "," },
        { "name": "punctuation.separator.colon.hsx", "match": ":" },
        { "name": "punctuation.separator.period.hsx", "match": "\\." }
      ]
    },

    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#tree-block" },
        { "include": "#control-flow" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#constants" },
        { "include": "#slot" },
        { "include": "#functions" },
        { "include": "#properties" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    }
  }
}
