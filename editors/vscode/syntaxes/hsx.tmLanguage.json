{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Serpent",
  "scopeName": "source.hsx",
  "fileTypes": ["hsx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#component" },
    { "include": "#tree-block" },
    { "include": "#control-flow" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hsx",
          "match": "#.*$"
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "name": "meta.import.hsx",
          "begin": "^\\s*(from)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.hsx" },
            "2": { "name": "entity.name.namespace.hsx" }
          },
          "end": "$",
          "patterns": [
            { "name": "keyword.control.import.hsx", "match": "\\b(import|as)\\b" },
            { "name": "punctuation.separator.comma.hsx", "match": "," }
          ]
        },
        {
          "name": "meta.import.hsx",
          "match": "^\\s*(import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.hsx" },
            "2": { "name": "entity.name.namespace.hsx" }
          }
        }
      ]
    },

    "component": {
      "patterns": [
        {
          "name": "meta.component.hsx",
          "begin": "^\\s*(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.component.hsx" },
            "2": { "name": "entity.name.type.component.hsx" }
          },
          "end": "(?=^\\s*\\S|\\z)",
          "patterns": [
            { "include": "#params" },
            { "include": "#type-annotation" },
            { "include": "#body" }
          ]
        }
      ]
    },

    "params": {
      "patterns": [
        {
          "name": "meta.params.hsx",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.hsx" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parens.end.hsx" } },
          "patterns": [
            { "include": "#type-annotation" },
            { "include": "#strings" },
            { "include": "#constants" },
            { "name": "variable.parameter.hsx", "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?::|=|,|\\)))" },
            { "name": "keyword.operator.assignment.hsx", "match": "=" },
            { "name": "punctuation.separator.comma.hsx", "match": "," },
            { "name": "keyword.operator.type.hsx", "match": "->" }
          ]
        }
      ]
    },

    "type-annotation": {
      "patterns": [
        {
          "name": "meta.type.hsx",
          "match": "(?<=:)\\s*([A-Za-z_][A-Za-z0-9_.]*(?:\\[[^\\]]*\\])?(?:\\s*\\|\\s*[A-Za-z_][A-Za-z0-9_.]*)*)",
          "captures": {
            "1": { "name": "support.type.hsx" }
          }
        }
      ]
    },

    "tree-block": {
      "comment": "A tag followed by ':' opens a JSX block. This is the core of the language.",
      "patterns": [
        {
          "name": "meta.tree.hsx",
          "begin": "^\\s*([a-z][a-z0-9]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.tag.hsx" },
            "2": { "name": "punctuation.section.parens.begin.hsx" }
          },
          "end": "\\)\\s*:",
          "endCaptures": { "0": { "name": "punctuation.section.block.begin.hsx" } },
          "patterns": [
            { "include": "#jsx-attributes" }
          ]
        },
        {
          "name": "meta.tree.hsx",
          "match": "^\\s*([a-z][a-z0-9]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "entity.name.tag.hsx" },
            "2": { "name": "punctuation.section.block.begin.hsx" }
          }
        }
      ]
    },

    "jsx-attributes": {
      "patterns": [
        {
          "name": "meta.attribute.hsx",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.hsx" },
            "2": { "name": "keyword.operator.assignment.hsx" }
          }
        },
        { "include": "#strings" },
        { "include": "#fstrings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "name": "punctuation.separator.comma.hsx", "match": "," },
        { "name": "punctuation.section.brackets.hsx", "match": "[\\[\\]\\{\\}]" },
        { "name": "punctuation.section.parens.hsx", "match": "[()]" }
      ]
    },

    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.hsx",
          "match": "\\b(if|elif|else|for|in|while|return|break|continue|pass|match|case|try|except|finally)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        { "name": "storage.type.function.hsx", "match": "\\b(def|async|await|export)\\b" },
        { "name": "storage.type.component.hsx", "match": "\\bcomponent\\b" },
        { "name": "keyword.control.flow.hsx", "match": "\\b(lambda|as|with)\\b" },
        { "name": "keyword.operator.logical.hsx", "match": "\\b(and|or|not|is)\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.hsx", "match": "\\b(True|False|None)\\b" }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#fstrings" },
        {
          "name": "string.quoted.double.hsx",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.hsx", "match": "\\\\." } ]
        },
        {
          "name": "string.quoted.single.hsx",
          "begin": "'",
          "end": "'",
          "patterns": [ { "name": "constant.character.escape.hsx", "match": "\\\\." } ]
        }
      ]
    },

    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.hsx",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.hsx",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.hsx" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.hsx" } },
              "patterns": [
                { "include": "#keywords" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "name": "variable.other.hsx", "match": "[A-Za-z_][A-Za-z0-9_]*" }
              ]
            },
            { "name": "constant.character.escape.hsx", "match": "\\\\." }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hsx", "match": "\\b\\d+(?:\\.\\d+)?\\b" }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.hsx", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.augmented.hsx", "match": "\\+=|-=|\\*=|/=" },
        { "name": "keyword.operator.arithmetic.hsx", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.hsx", "match": "=" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.parens.hsx", "match": "[()]" },
        { "name": "punctuation.section.brackets.hsx", "match": "[\\[\\]]" },
        { "name": "punctuation.section.braces.hsx", "match": "[\\{\\}]" },
        { "name": "punctuation.separator.comma.hsx", "match": "," },
        { "name": "punctuation.separator.period.hsx", "match": "\\." }
      ]
    },

    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#tree-block" },
        { "include": "#control-flow" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    }
  }
}
