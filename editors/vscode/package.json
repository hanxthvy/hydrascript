{
  "name": "hydrascript",
  "displayName": "HydraScript (HYX / HYS)",
  "description": "Syntax highlighting and inline compiler diagnostics for HydraScript (.hyx, .hys, .hsx, and .hs)",
  "version": "0.1.0",
  "publisher": "hydrascript",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["react", "python", "hydrascript", "hyx", "hys", "hsx", "hs", "jsx"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:hyx", "onLanguage:hys", "onLanguage:hsx", "onLanguage:hs"],
  "contributes": {
    "languages": [
      {
        "id": "hyx",
        "aliases": ["Hydra JSX", "HydraScript (React)", "hyx", "hsx"],
        "extensions": [".hyx", ".hsx"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hys",
        "aliases": ["Hydra Script", "HydraScript (Script)", "hys", "hs", "hx"],
        "extensions": [".hys", ".hs", ".hx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hyx",
        "scopeName": "source.hsx",
        "path": "./syntaxes/hsx.tmLanguage.json"
      },
      {
        "language": "hys",
        "scopeName": "source.hsx",
        "path": "./syntaxes/hsx.tmLanguage.json"
      },
      {
        "language": "hsx",
        "scopeName": "source.hsx",
        "path": "./syntaxes/hsx.tmLanguage.json"
      },
      {
        "language": "hs",
        "scopeName": "source.hsx",
        "path": "./syntaxes/hsx.tmLanguage.json"
      }
    ]
  },
  "files": ["extension.js", "language-configuration.json", "syntaxes/", "bin/"]
}
